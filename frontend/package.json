{
  "name": "pz-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm check:translations && pnpm lint && pnpm format:check && tsc && pnpm test:run",
    "check:translations": "node ./scripts/translations/validate-ui.mjs",
    "format": "pnpm format:translations && prettier --write .",
    "format:translations": "node ./scripts/translations/format.mjs --write",
    "format:check": "node ./scripts/translations/format.mjs --check && prettier --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives src scripts vite.config.ts",
    "lint:fix": "oxlint --deny-warnings --report-unused-disable-directives --fix src scripts vite.config.ts",
    "scrape:vehicles:42": "node ./scripts/catalogs/vehicles/scrape-build-42.mjs",
    "generate:icons": "node ./scripts/icons/generate.mjs",
    "generate:items": "node ./scripts/catalogs/items/generate.mjs",
    "generate:vehicles": "node ./scripts/catalogs/vehicles/generate.mjs",
    "generate:options:reference": "node ./scripts/catalogs/options/generate-reference.mjs",
    "generate:items:translations": "node ./scripts/translations/generate-items.mjs",
    "generate:skills:translations": "node ./scripts/translations/generate-skills.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@mantine/core": "9.5.1",
    "@mantine/form": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@mantine/notifications": "9.5.1",
    "@mantine/tiptap": "9.5.1",
    "@tabler/icons-react": "3.46.0",
    "@tiptap/extension-color": "3.30.3",
    "@tiptap/extension-text-align": "3.30.3",
    "@tiptap/extension-text-style": "3.30.3",
    "@tiptap/pm": "3.30.3",
    "@tiptap/react": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "@wailsio/runtime": "3.0.0-beta.24",
    "i18next": "26.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "cheerio": "1.2.0",
    "jsdom": "30.0.1",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss-preset-mantine": "1.18.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
