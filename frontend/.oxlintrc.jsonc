{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn",
  },
  "ignorePatterns": ["bindings/**", "dist/**"],
  "options": {
    "typeAware": true,
  },
  "overrides": [
    {
      // Mantine and Wails expose strings that we narrow to application unions.
      "files": [
        "src/components/layout/ApplicationShell.tsx",
        "src/pages/SettingsPage.tsx",
        "src/providers/AppConfigProvider.tsx",
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
      },
    },
    {
      // Async save/delete handlers are passed to void-returning component props.
      "files": ["src/pages/AdminPanelPage.tsx"],
      "rules": {
        "typescript/no-misused-promises": "off",
      },
    },
    {
      // The update parameter shadows the current derived language value.
      "files": ["src/providers/AppConfigProvider.tsx"],
      "rules": {
        "eslint/no-shadow": "off",
      },
    },
  ],
  "plugins": [
    "import",
    "jsx-a11y",
    "promise",
    "react",
    "typescript",
    "unicorn",
  ],
  "rules": {
    "import/no-unassigned-import": "off",
    "promise/always-return": "off",
    "react/jsx-no-constructed-context-values": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": true,
      },
    ],
    "unicorn/no-array-sort": "off",
  },
}
